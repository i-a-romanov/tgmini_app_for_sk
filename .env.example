# Production: enter these in Render Environment, not in Git.
NODE_ENV=production
BOT_TOKEN=
DATABASE_URL=
# 32+ random characters. render.yaml generates this automatically.
WEBHOOK_SECRET=
# Render supplies RENDER_EXTERNAL_URL automatically; APP_URL overrides it.
# APP_URL=https://your-service.onrender.com
AUTO_CONFIGURE_BOT=true
ENABLE_REMINDERS=true
PILOT_MODE=true
OPERATOR_NAME="Команда SK Fast Track"
# Optional real team contact, shown on the help screen.
# SUPPORT_URL=https://t.me/your_support_username
# Use verified TLS for externally hosted Postgres if required by its provider.
# DATABASE_SSL=true

# For local testing simply run npm run dev without copying this file.
# DEV_AUTH must never be enabled on Render.
